{
  "name": "developer-profile-api",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.9.0 <25"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check package.json package-lock.json nest-cli.json tsconfig*.json eslint.config.mjs .prettierrc.json prisma.config.ts compose.yaml compose.prod.yaml \"src/**/*.ts\" \"prisma/**/*.ts\" \"test/**/*.ts\" test/jest-e2e.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config test/jest-e2e.json"
  },
  "overrides": {
    "@nestjs/cli": {
      "webpack": "5.112.2"
    }
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "14.1.2",
    "@nestjs/common": "12.3.3",
    "@nestjs/config": "12.1.0",
    "@nestjs/core": "12.3.3",
    "@nestjs/graphql": "14.1.2",
    "@nestjs/platform-express": "12.3.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dataloader": "2.2.3",
    "dotenv": "18.0.3",
    "graphql": "16.14.2",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/prisma",
      "<rootDir>/test"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "prisma/**/*.ts",
      "!src/main.ts",
      "!src/generated/**",
      "!**/*.spec.ts"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "12.3.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
